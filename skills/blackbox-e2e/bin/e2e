#!/usr/bin/env bash
# The black-box tester's only command. The tester runs it as `e2e` (a shim on its PATH,
# outside the sandbox, that execs this file). The profile and the run's values come from
# $E2E_PRIV/e2e.env, which lives outside the sandbox. Every verb validates its arguments.
#
#   e2e start | stop | status     -> profile_start / profile_stop / profile_status
#   e2e shot NAME                 screenshot -> ./shots/NAME.png (max MAX_SHOTS)
#   e2e tap X Y | swipe X1 Y1 X2 Y2 [MS] | key KEYSYM | type TEXT
#   e2e wait SECONDS              (<= 180)
#   e2e log PATTERN-NAME [N]      declared regex over this run's logs, last N (<= 100) lines
#   e2e patterns | fixtures       list the declared names
#   e2e fixture NAME              apply a declared fixture (profile_fixture FILE live)
#   e2e git log|show|diff|blame|grep [ARGS]   white-box runs only: read the source history
# A && B || die: B is always a test, so die runs exactly when a check fails.
# shellcheck disable=SC2015
# shellcheck source-path=SCRIPTDIR
set -uo pipefail

[ -n "${E2E_PRIV:-}" ] && [ -f "$E2E_PRIV/e2e.env" ] || { echo "e2e: not configured" >&2; exit 2; }
# shellcheck source=/dev/null
. "$E2E_PRIV/e2e.env"            # PROFILE, SKILL_DIR first: then the profile, then the values
# shellcheck source=../lib/stack.sh
. "$SKILL_DIR/lib/stack.sh"
# shellcheck source=/dev/null
. "$PROFILE"
# shellcheck source=/dev/null
. "$E2E_PRIV/e2e.env"            # values computed by the runner win over profile defaults

is_int() { [[ "$1" =~ ^[0-9]{1,5}$ ]]; }
ud() { if [ "$UI_TARGET" = local ]; then "$UIDRIVE" -d "$UI_DISPLAY" "$@"; else "$UIDRIVE" -t "$UI_TARGET" "$@"; fi; }

# --- budget: every call counts, including refused ones ---------------------------
count_call() {
    local n
    n=$(( $(cat "$E2E_PRIV/calls" 2>/dev/null || echo 0) + 1 ))
    echo "$n" > "$E2E_PRIV/calls"
    printf '%s %s\n' "$(date +%T)" "$*" >> "$E2E_PRIV/calls.log"
    # stop/status stay available so the tester can always clean up and report.
    if [ "$n" -gt "$MAX_CALLS" ] && [ "${1:-}" != stop ] && [ "${1:-}" != status ]; then
        die "call budget exhausted ($MAX_CALLS). Stop and write the report now."
    fi
}

# --- scenario sections (declared names only) -------------------------------------
section() {  # section "Heading" -> lines of that ## section
    awk -v h="$1" '/^## /{ on = (substr($0, 4) == h); next } on' "$SCENARIO"
}
pattern_of() {  # pattern_of NAME: "- name: regex" lines under "## Log patterns"
    section "Log patterns" | P="$1" perl -ne 'if (/^\s*[-*]\s*`?([A-Za-z0-9_-]+)`?\s*:\s*(.+?)\s*$/ && $1 eq $ENV{P}) { $r = $2; $r =~ s/^`(.*)`$/$1/; print "$r\n"; exit }'
}
fixture_names() { [ -f "$FIXTURES" ] && sed -nE 's/^--[[:space:]]*@fixture[[:space:]]+([A-Za-z0-9_-]+).*/\1/p' "$FIXTURES"; }
in_safety_rect() {  # in_safety_rect X Y -> 0 when inside a "rect: x1 y1 x2 y2" of ## Safety
    section "Safety" | X="$1" Y="$2" perl -ne 'BEGIN { ($x, $y) = @ENV{qw(X Y)} }
        if (/rect:\s*(\d+)\s+(\d+)\s+(\d+)\s+(\d+)/ && $x >= $1 && $x <= $3 && $y >= $2 && $y <= $4) { $hit = 1 }
        END { exit($hit ? 0 : 1) }'
}
check_xy() {
    is_int "$1" && is_int "$2" || die "coordinates must be integers"
    [ "$1" -lt "$SCREEN_W" ] && [ "$2" -lt "$SCREEN_H" ] || die "coordinates outside ${SCREEN_W}x${SCREEN_H}"
    in_safety_rect "$1" "$2" && die "refused: ($1,$2) is inside a Safety rect of the scenario"
    return 0
}

# --- verbs ---------------------------------------------------------------------------
verb=${1:-}; shift || true
# One verb at a time: some agents (Copilot) issue tool calls in parallel, which would
# race a tap against the screenshot meant to verify it.
exec 8> "$E2E_PRIV/verb.lock"
if ! flock -w 200 8; then
    [ "$verb" = stop ] || die "another e2e call is still running; retry after it returns"
fi
count_call "$verb" "$@"
case "$verb" in
    start)  record_log_offsets; profile_start ;;
    stop)   profile_stop ;;
    status) profile_status ;;
    shot)
        [ $# -eq 1 ] && [[ "$1" =~ ^[A-Za-z0-9_-]{1,40}$ ]] || die "usage: shot NAME ([A-Za-z0-9_-])"
        n=$(( $(cat "$E2E_PRIV/shots" 2>/dev/null || echo 0) + 1 ))
        [ "$n" -le "$MAX_SHOTS" ] || die "screenshot budget exhausted ($MAX_SHOTS); use log evidence"
        echo "$n" > "$E2E_PRIV/shots"
        raw="$E2E_PRIV/raw-$1.png"
        ud shot "$raw" >/dev/null || die "screenshot failed"
        convert "$raw" -resize "${SHOT_WIDTH}x" "$SANDBOX/shots/$1.png" || die "resize failed"
        echo "shots/$1.png (${n}/${MAX_SHOTS}; native ${SCREEN_W}x${SCREEN_H}, image scaled to width ${SHOT_WIDTH}: multiply by $(awk -v w="$SCREEN_W" -v s="$SHOT_WIDTH" 'BEGIN { printf "%g", w / s }') for tap coordinates)"
        ;;
    tap)    [ $# -eq 2 ] || die "usage: tap X Y"; check_xy "$1" "$2"; ud tap "$1" "$2" ;;
    swipe)
        [ $# -ge 4 ] && [ $# -le 5 ] || die "usage: swipe X1 Y1 X2 Y2 [MS]"
        check_xy "$1" "$2"; check_xy "$3" "$4"
        [ $# -eq 4 ] || { is_int "$5" && [ "$5" -le 3000 ]; } || die "MS must be <= 3000"
        ud swipe "$@" ;;
    key)    [ $# -eq 1 ] && [[ "$1" =~ ^[A-Za-z0-9_]{1,20}$ ]] || die "usage: key KEYSYM"; ud key "$1" ;;
    type)   [ $# -eq 1 ] && [[ "$1" =~ ^[[:print:]]{1,80}$ ]] || die "usage: type 'TEXT' (<= 80 chars)"; ud type "$1" ;;
    wait)   [ $# -eq 1 ] && is_int "$1" && [ "$1" -le 180 ] || die "usage: wait SECONDS (<= 180)"; sleep "$1"; echo "waited $1 s" ;;
    patterns) # shellcheck disable=SC2016
        section "Log patterns" | sed -nE 's/^\s*[-*]\s*`?([A-Za-z0-9_-]+)`?\s*:.*/\1/p' ;;
    fixtures) fixture_names | grep -vx setup ;;
    log)
        [ $# -ge 1 ] && [ $# -le 2 ] && [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "usage: log PATTERN-NAME [N]"
        re=$(pattern_of "$1"); [ -n "$re" ] || die "undeclared pattern '$1' (see: e2e patterns)"
        n=${2:-20}; is_int "$n" && [ "$n" -le 100 ] || die "N must be <= 100"
        [ -s "$E2E_PRIV/log-offsets" ] || die "stack not started by this run, or the profile has no logs"
        while read -r f off; do
            log_delta "$f" "$off" | grep -aE -- "$re" | sed "s|^|$(basename "$f"): |"
        done < "$E2E_PRIV/log-offsets" \
            | perl -pe 's/[\w\/.-]+\.(?:c|cc|cpp|h|hpp|qml|js|jsx|ts|tsx|py|java|kt|go|rs):\d+/<src>/g; s/\b\w+(?:::\w+)+\(\)?/<fn>/g' \
            | cut -c1-800 | tail -n "$n" > "$E2E_PRIV/log.out"
        if [ -s "$E2E_PRIV/log.out" ]; then cat "$E2E_PRIV/log.out"; else echo "(no matching lines)"; fi
        ;;
    fixture)
        [ $# -eq 1 ] && [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] && [ "$1" != setup ] || die "usage: fixture NAME"
        fixture_names | grep -qx "$1" || die "undeclared fixture '$1' (see: e2e fixtures)"
        declare -F profile_fixture > /dev/null || die "this target has no fixture support"
        awk -v n="$1" '/^--[[:space:]]*@fixture[[:space:]]/{ on = ($3 == n); next } on' "$FIXTURES" > "$E2E_PRIV/fixture.sql"
        profile_fixture "$E2E_PRIV/fixture.sql" live || die "fixture '$1' failed"
        echo "fixture $1 applied"
        ;;
    git)
        [ -n "${SOURCE:-}" ] || die "git is only available in white-box runs"
        sub=${1:-}; shift || true
        [[ "$sub" =~ ^(log|show|diff|blame|grep)$ ]] || die "usage: git log|show|diff|blame|grep [ARGS]"
        for a in "$@"; do
            # Options that write files, read outside the repo, or run programs. (Config -c only
            # exists before the subcommand, and these arguments always come after it.)
            [[ "$a" =~ ^(--output|-O|--open-files-in-pager|--ext-diff|--textconv|--no-index|--contents|--exec|--upload-pack) ]] \
                && die "git option refused: $a"
            [[ "$a" =~ ^[[:print:]]{1,200}$ ]] || die "git arguments must be printable, <= 200 chars"
        done
        noext=(); [ "$sub" = grep ] || [ "$sub" = blame ] || noext=(--no-ext-diff --no-textconv)
        git --no-pager -C "$SOURCE" -c core.pager=cat -c diff.external= "$sub" "${noext[@]}" "$@" 2>&1 \
            | head -n 400 > "$E2E_PRIV/git.out"
        cat "$E2E_PRIV/git.out"
        [ "$(wc -l < "$E2E_PRIV/git.out")" -lt 400 ] || echo "(output truncated at 400 lines; narrow the query)"
        ;;
    *) die "unknown verb '$verb'. Verbs: start stop status shot tap swipe key type wait log patterns fixtures fixture git" ;;
esac
