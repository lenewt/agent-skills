#!/usr/bin/env python3
"""session-cost: the calling dev session's cumulative cost, for usage.jsonl.

Prints one JSON value and always exits 0 (best effort, stdlib only, well under 1 s):
  {"tool": "claude", "id": ID, "cost_usd": X|null}
  {"tool": "copilot", "id": ID, "cost_usd": X|null, "premium_requests": N|null}
  null  when no calling session is found.

Which session: the nearest ancestor process named claude or copilot decides the tool (a
Copilot CLI started from Claude Code inherits CLAUDE_* and the reverse holds too); its id
comes from CLAUDE_CODE_SESSION_ID or COPILOT_AGENT_SESSION_ID. Without /proc, the id that is
set wins (copilot first). The tester never runs this: the runner calls it with its own env.

Claude Code: the transcript <config>/projects/*/<id>.jsonl holds `cost-state` records, one
counter per CLI process (startTime) that wrote to the session (resumes, SDK runs), each
cumulative for that process. Cost = sum over startTime of the last totalCostUSD. They are
written at intervals, so the value can lag the live session; null when there is none yet.

Copilot CLI: ~/.copilot/session-store.db, table assistant_usage_events, one row per model
call (live): cost = sum(total_nano_aiu) / 1e9 AI credits * $0.01; premium requests =
sum(request_multiplier) of user-initiated calls. (events.jsonl checkpoints lag and reset.)
"""
import glob
import json
import os
import sqlite3
import sys


def ancestor_tool():
    pid = os.getppid()
    for _ in range(40):
        if pid <= 1:
            return None
        try:
            with open("/proc/%d/comm" % pid) as f:
                comm = f.read().strip().lower()
            exe = os.path.realpath("/proc/%d/exe" % pid).lower() if os.path.exists("/proc/%d/exe" % pid) else ""
            with open("/proc/%d/stat" % pid) as f:
                ppid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            return None
        for tool in ("copilot", "claude"):
            if tool in comm or "/%s/" % tool in exe or exe.endswith("/" + tool):
                return tool
        pid = ppid
    return None


def claude_cost(sid):
    home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    files = glob.glob(os.path.join(home, "projects", "*", sid + ".jsonl"))
    if not files:
        return None
    last = {}
    with open(max(files, key=os.path.getmtime), errors="replace") as f:
        for line in f:
            if '"cost-state"' not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get("type") == "cost-state" and isinstance(d.get("totalCostUSD"), (int, float)):
                last[d.get("startTime")] = d["totalCostUSD"]
    return round(sum(last.values()), 6) if last else None


def copilot_cost(sid):
    home = os.environ.get("COPILOT_HOME") or os.path.expanduser("~/.copilot")
    db = os.path.join(home, "session-store.db")
    if not os.path.exists(db):
        return None, None
    con = sqlite3.connect("file:%s?mode=ro" % db, uri=True, timeout=0.5)
    try:
        nano, prem, n = con.execute(
            "SELECT sum(total_nano_aiu), sum(CASE WHEN initiator = 'user' THEN request_multiplier ELSE 0 END), count(*)"
            " FROM assistant_usage_events WHERE session_id = ?", (sid,)).fetchone()
    finally:
        con.close()
    if not n:
        return None, None
    return round((nano or 0) / 1e9 * 0.01, 6), (int(prem) if prem == int(prem or 0) else prem)


def main():
    ids = {"claude": os.environ.get("CLAUDE_CODE_SESSION_ID"), "copilot": os.environ.get("COPILOT_AGENT_SESSION_ID")}
    tool = ancestor_tool()
    if tool is None or not ids.get(tool):
        tool = "copilot" if ids["copilot"] else "claude" if ids["claude"] else None
    if tool is None:
        return None
    sid = ids[tool]
    out = {"tool": tool, "id": sid, "cost_usd": None}
    if tool == "copilot":
        out["premium_requests"] = None
    try:
        if tool == "claude":
            out["cost_usd"] = claude_cost(sid)
        else:
            out["cost_usd"], out["premium_requests"] = copilot_cost(sid)
    except Exception:  # noqa: BLE001  best effort: the id alone is still useful
        pass
    return out


if __name__ == "__main__":
    try:
        res = main()
    except Exception:  # noqa: BLE001  never fail the run
        res = None
    sys.stdout.write(json.dumps(res) + "\n")
