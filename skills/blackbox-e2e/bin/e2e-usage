#!/usr/bin/env bash
# e2e-usage: what the e2e skills cost, per skill and per calling dev session, from the global
# ledger $E2E_USAGE_LOG (default ~/.local/state/blackbox-e2e/usage.jsonl; one line per tester or
# scout run: date, skill, engine, model, cost_usd, wall_s, session; nothing about scenarios).
#
#   e2e-usage [--since YYYY-MM-DD] [--json]
#
# Per session: e2e runs and cost, the last known cost of the session itself (its own counter,
# without the testers), and the e2e share of both together: e2e / (session + e2e).
set -euo pipefail

usage() { awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; exit 2; }
SINCE="" JSON=0
while [ $# -gt 0 ]; do
    case "$1" in
        --since) [[ "${2:-}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || usage; SINCE=$2; shift 2 ;;
        --json)  JSON=1; shift ;;
        *) usage ;;
    esac
done
F=${E2E_USAGE_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/blackbox-e2e/usage.jsonl}
[ -s "$F" ] || { echo "no usage recorded yet ($F)" >&2; exit 0; }

# Unreadable lines are skipped; dates are ISO 8601, so string order is time order.
SUM=$(jq -R 'fromjson? // empty' "$F" | jq -sc --arg since "$SINCE" '
    def tot: {runs: length, cost_usd: (map(.cost_usd // 0) | add // 0)}
        | .mean_usd = (if .runs > 0 then .cost_usd / .runs else 0 end);
    map(select((.date // "") >= $since))
    | {since: (if $since == "" then null else $since end),
       skills: (group_by(.skill) | map({skill: (.[0].skill // "?")} + tot)),
       sessions: (map(select(.session.id? | type == "string")) | group_by(.session.id)
         | map({session: .[0].session.id, tool: .[0].session.tool, runs: length,
                e2e_cost_usd: (map(.cost_usd // 0) | add),
                session_cost_usd: ([.[] | .session.cost_usd | numbers] | max)}
               | .e2e_share_pct = (if .session_cost_usd then .e2e_cost_usd / (.session_cost_usd + .e2e_cost_usd) * 100
                                   else null end))),
       total: tot}')
if [ "$JSON" = 1 ]; then jq . <<< "$SUM"; exit 0; fi
jq -r '"usage \(if .since then "since \(.since)" else "(all runs)" end)",
    ((.skills + [{skill: "total"} + .total])[]
     | [.skill, .runs, .cost_usd, .mean_usd] | @tsv)' <<< "$SUM" \
    | awk -F'\t' 'NR == 1 { print; printf "%-16s %6s %10s %10s\n", "skill", "runs", "cost", "mean"; next }
                  { printf "%-16s %6d %10s %10s\n", $1, $2, sprintf("$%.4f", $3), sprintf("$%.4f", $4) }'
[ "$(jq '.sessions | length' <<< "$SUM")" -gt 0 ] || exit 0
echo
jq -r '.sessions[] | [.session, .tool, .runs, .e2e_cost_usd, (.session_cost_usd // "?"), (.e2e_share_pct // "?")] | @tsv' <<< "$SUM" \
    | awk -F'\t' 'NR == 1 { printf "%-38s %-8s %6s %10s %12s %7s\n", "session", "tool", "runs", "e2e cost", "session cost", "e2e %" }
                  { printf "%-38s %-8s %6d %10s %12s %7s\n", $1, $2, $3, sprintf("$%.4f", $4),
                           ($5 == "?" ? "?" : sprintf("$%.2f", $5)), ($6 == "?" ? "?" : sprintf("%.1f%%", $6)) }'
